# Clave para sellar la cookie de sesión (mínimo 32 caracteres)
NUXT_SESSION_PASSWORD=cambia-esto-por-una-clave-de-32-caracteres-o-mas

# Hosts de Redmine permitidos para el proxy, separados por coma
NUXT_REDMINE_ALLOWED_HOSTS=redmine.miempresa.local,localhost:3000

# Opcional (F12): clave de la API de Anthropic para todos. Si no, cada persona la guarda en Ajustes.
NUXT_ANTHROPIC_API_KEY=
